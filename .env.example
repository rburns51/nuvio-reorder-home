# Nuvio Reorder Home, standalone public deployment env.
# Copy this file to .env and fill in the values.
# Do not point this app at the main NuvioSync environment file.

# Required: publishable Nuvio/Supabase anon key.
# Never use a service role key here.
NUVIO_ANON_KEY=

# Optional unless the Nuvio project URL changes.
NUVIO_PROJECT_URL=https://dpyhjjcoabcglfmgecug.supabase.co

# Required: long random secret used to encrypt temporary browser session cookies.
FLASK_SECRET=

# Required for the included Traefik labels.
NUVIO_REORDER_HOST=nuvio-reorder.example.com
TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_CERTRESOLVER=myresolver

FLASK_PRODUCTION=true
FLASK_ENV=production
TRUST_PROXY=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_HOURS=8
PORT=7862
LOG_LEVEL=INFO
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120
NUVIO_API_DEBUG=false
PUBLIC_ERROR_DETAILS=false
HEALTH_REVEALS_CONFIG=false
SECURITY_HEADERS=true
CACHE_CONTROL_NO_STORE=true
LOGIN_RATE_LIMIT_CALLS=5
LOGIN_RATE_LIMIT_WINDOW=300
LOGIN_LOCKOUT_SECONDS=900
API_RATE_LIMIT_CALLS=180
API_RATE_LIMIT_WINDOW=60
RATE_LIMIT_STATE_MAX_KEYS=5000
MAX_CONTENT_LENGTH_BYTES=2097152
NUVIO_HTTP_TIMEOUT_SECONDS=20
REFRESH_JWT_BEFORE_SECONDS=300
