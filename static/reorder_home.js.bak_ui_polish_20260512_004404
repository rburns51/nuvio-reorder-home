let selectedProfileId = null;
let profiles = [];
let baseRows = [];
let viewMode = 'custom';
let searchQuery = '';
let searchMatchKeys = [];
let searchMatchIndex = -1;
let rowTypeFilter = 'all';
let statusFilter = 'all';
let duplicatesOnly = false;
let hideHiddenCatalogs = false;
let positionEditUnlocked = false;
let loadInFlight = false;
let saveInFlight = false;
let profilesInFlight = false;
let removedRowKeys = new Set();
let selectedCatalogKeys = new Set();
let undoOrderStack = [];
let savedRowsFingerprint = '';
let loadedProfileSummary = null;
let loadedAtTimestamp = null;
let selectedPlatform = 'tv';
let savePlatformScope = 'tv';
let lastHomeHealth = null;
let stateEffectiveAddonProfileId = null;
let stateAddonInventorySource = 'selected_profile';
let stateInheritedAddonProfiles = [];
let pendingApplyHomeToInheritedProfileIds = [];
let dragKey = null;
