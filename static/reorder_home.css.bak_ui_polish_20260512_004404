/* Standalone Reorder Home page polish */
.rh-shell .card { overflow: hidden; }
.session-pill {
  max-width: min(34vw, 360px);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  border: 1px solid var(--border);
  background: color-mix(in srgb, var(--surface-2) 68%, transparent);
  color: var(--text-muted);
  border-radius: 999px;
  padding: .38rem .62rem;
  font-size: .76rem;
  font-weight: 700;
}
.login-wrap {
  display: grid;
  place-items: start center;
  min-height: 68vh;
  padding-top: clamp(1rem, 5vh, 3rem);
}
.login-card { width: min(680px, 100%); }
.login-body { display: grid; gap: .72rem; }
.form-label { color: var(--text-muted); font-size: .78rem; font-weight: 760; }
.login-note {
  margin-top: .2rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--surface-2) 60%, transparent);
  color: var(--text-muted);
  padding: .72rem .82rem;
  font-size: .8rem;
  line-height: 1.45;
}
.rh-layout {
  display: grid;
  grid-template-columns: minmax(250px, 292px) minmax(0, 1fr);
  gap: .95rem;
  align-items: start;
}
@media (max-width: 820px) { .rh-layout { grid-template-columns: 1fr; } }
.rh-section-stack, .section-stack { display: grid; gap: .85rem; }
.rh-card-head-wrap { gap: .75rem; flex-wrap: wrap; }
.rh-save-actions, .rh-toolbar, .rh-toolbar-search, .rh-filter-row, .rh-bulk-select-actions {
  display: flex;
  align-items: center;
  gap: .5rem;
  flex-wrap: wrap;
}
.rh-toolbar { justify-content: space-between; margin-bottom: .7rem; }
.rh-toolbar-search { margin-bottom: .55rem; }
.rh-filter-row { margin-bottom: .7rem; }
.rh-toolbar-search .input { flex: 1 1 280px; }
.rh-filter-row .input { flex: 1 1 180px; }
.segmented-control {
  display: inline-flex;
  align-items: center;
  gap: .2rem;
  padding: .2rem;
  border: 1px solid var(--border);
  background: color-mix(in srgb, var(--surface-2) 52%, transparent);
  border-radius: 999px;
}
.segmented-control .btn { border-radius: 999px; padding: .32rem .68rem; }
.inline-check {
  display: inline-flex;
  align-items: center;
  gap: .42rem;
  color: var(--text-muted);
  font-size: .78rem;
  font-weight: 700;
  white-space: nowrap;
}
.inline-check input { width: 1.02rem; height: 1.02rem; accent-color: var(--accent); }
.rh-select {
  width: 100%;
  min-height: 38px;
  border-radius: var(--radius-control);
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  padding: .45rem .55rem;
}
.pick-label { color: var(--text-muted); font-size: .74rem; font-weight: 800; margin: .1rem 0 .25rem; display: block; }
.rh-platform-panel, .rh-profile-health, .rh-panel-subtle {
  border: 1px solid var(--border);
  background: color-mix(in srgb, var(--surface-2) 56%, transparent);
  border-radius: var(--radius-sm);
  padding: .65rem;
}
.rh-platform-panel { display: grid; gap: .38rem; }
.rh-health-pills { display: flex; flex-wrap: wrap; gap: .35rem; }
.rh-health-pill {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  min-height: 23px;
  padding: .16rem .45rem;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: color-mix(in srgb, var(--surface) 72%, transparent);
  color: var(--text-muted);
  font-size: .66rem;
  font-weight: 750;
}
.rh-health-pill strong { color: var(--text); }
.rh-profile-health-detail { margin-top: .55rem; line-height: 1.35; }
.rh-health-warning {
  border: 1px solid rgba(245, 158, 11, .35);
  background: rgba(245, 158, 11, .08);
  color: var(--text);
  border-radius: 12px;
  padding: .55rem .7rem;
  font-size: .78rem;
  line-height: 1.35;
  margin-top: .5rem;
}
.rh-row-list { display: flex; flex-direction: column; gap: .38rem; }
.rh-row {
  display: grid;
  grid-template-columns: auto auto auto minmax(0, 1fr) auto;
  align-items: center;
  gap: .52rem;
  padding: .55rem .62rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  background: var(--gradient-card);
  box-shadow: var(--panel-highlight);
  min-width: 0;
  transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease, opacity var(--dur-fast) ease;
}
.rh-row:hover { border-color: color-mix(in srgb, var(--accent) 28%, var(--border)); background: var(--gradient-card-hover); }
.rh-row.is-dragging { opacity: .5; }
.rh-row.is-drop-target { border-color: color-mix(in srgb, var(--accent) 72%, var(--border)); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 16%, transparent); }
.rh-row.is-match { border-color: color-mix(in srgb, var(--accent) 34%, var(--border)); background: color-mix(in srgb, var(--accent) 6%, var(--surface-2)); }
.rh-row.is-search-current { border-color: color-mix(in srgb, var(--accent) 68%, var(--border)); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 18%, transparent); }
.rh-row.is-hidden-row { opacity: .72; }
.rh-row-drag-handle {
  color: var(--text-dim);
  cursor: grab;
  font-size: .95rem;
  touch-action: none;
  user-select: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.rh-catalog-select-checkbox { width: 1rem; height: 1rem; accent-color: var(--accent); }
.rh-position-control { display: inline-flex; align-items: center; gap: .18rem; color: var(--text-muted); font-size: .68rem; font-weight: 750; }
.rh-position-input {
  width: 3.6rem;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: color-mix(in srgb, var(--surface-2) 72%, transparent);
  color: var(--text);
  padding: .22rem .34rem;
  text-align: center;
  font-size: .75rem;
  font-weight: 800;
}
.rh-position-input[readonly] { cursor: pointer; color: var(--text-muted); background: color-mix(in srgb, var(--surface-2) 38%, transparent); }
.rh-position-input:disabled { opacity: .38; cursor: not-allowed; }
.rh-position-input:focus { outline: none; border-color: color-mix(in srgb, var(--accent) 65%, var(--border)); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 16%, transparent); }
.rh-row-info { min-width: 0; display: grid; gap: .16rem; }
.rh-row-title { font-weight: 800; font-size: .86rem; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rh-row-sub { color: var(--text-muted); font-size: .72rem; line-height: 1.28; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rh-row-tags { display: flex; flex-wrap: wrap; gap: .24rem; min-width: 0; }
.rh-row-badge, .rh-row-status {
  display: inline-flex;
  align-items: center;
  min-height: 22px;
  max-width: 100%;
  min-width: 0;
  gap: .28rem;
  font-size: .66rem;
  font-weight: 760;
  padding: .14rem .42rem;
  border-radius: 999px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rh-row-badge.catalog { background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--accent-light); border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); }
.rh-row-badge.collection { background: color-mix(in srgb, var(--success) 14%, transparent); color: color-mix(in srgb, var(--success) 90%, #fff); border: 1px solid color-mix(in srgb, var(--success) 35%, var(--border)); }
.rh-row-badge.type-tag, .rh-row-status.muted { background: color-mix(in srgb, var(--text-dim) 16%, transparent); color: var(--text-muted); border: 1px solid var(--border); font-weight: 650; }
.rh-row-status.visible { background: color-mix(in srgb, var(--success) 10%, transparent); color: color-mix(in srgb, var(--success) 80%, var(--text)); border: 1px solid color-mix(in srgb, var(--success) 28%, var(--border)); }
.rh-row-status.hidden { background: color-mix(in srgb, var(--danger) 12%, transparent); color: color-mix(in srgb, var(--danger) 82%, var(--text)); border: 1px solid color-mix(in srgb, var(--danger) 32%, var(--border)); }
.rh-row-status.warning { background: rgba(245, 158, 11, .10); color: #a16207; border: 1px solid rgba(245, 158, 11, .45); }
.rh-row-status.pinned { background: rgba(245, 158, 11, .10); color: color-mix(in srgb, var(--warning) 88%, var(--text)); border: 1px solid rgba(245, 158, 11, .35); }
.rh-row-actions { display: flex; flex-wrap: wrap; gap: .34rem; align-items: center; justify-content: flex-end; min-width: 0; }
.rh-row-action-btn, .rh-row-danger-btn, .rh-move-btn {
  border: 1px solid var(--border);
  background: color-mix(in srgb, var(--surface-2) 60%, transparent);
  color: var(--text);
  border-radius: var(--radius-control);
  min-height: 30px;
  padding: .36rem .55rem;
  font-size: .72rem;
  font-weight: 800;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .3rem;
}
.rh-row-action-btn:hover, .rh-row-danger-btn:hover, .rh-move-btn:hover:not(:disabled) { transform: translateY(-1px); }
.rh-row-danger-btn, .btn-danger { border-color: rgba(239, 68, 68, .45); background: rgba(239, 68, 68, .08); color: #b91c1c; }
.rh-row-controls { display: grid; gap: .22rem; }
.rh-move-btn { min-width: 30px; min-height: 24px; padding: .16rem .34rem; color: var(--text-muted); border-radius: 8px; }
.rh-move-btn:disabled { opacity: .35; cursor: not-allowed; }

.rh-skeleton {
  min-height: 48px;
  border-radius: var(--radius-card);
  border: 1px solid var(--border);
  background: linear-gradient(90deg, var(--skeleton-base, rgba(148,163,184,.12)) 0%, var(--skeleton-highlight, rgba(148,163,184,.22)) 50%, var(--skeleton-base, rgba(148,163,184,.12)) 100%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.25s ease-in-out infinite;
}
@keyframes skeleton-shimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }

.rh-info-bar, .rh-revert-banner, .rh-bulk-select-bar {
  padding: .58rem .68rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--surface-2) 60%, transparent);
  color: var(--text-muted);
  font-size: .78rem;
  line-height: 1.35;
  margin-bottom: .7rem;
}
.rh-revert-banner { display: flex; align-items: center; gap: .45rem; color: var(--text-muted); }
.rh-bulk-select-bar { display: flex; align-items: center; justify-content: space-between; gap: .75rem; flex-wrap: wrap; }
.rh-bulk-select-copy { display: grid; gap: .12rem; min-width: 190px; }
.rh-match-count { white-space: nowrap; }
.rh-unsaved-pill { white-space: nowrap; opacity: 0; pointer-events: none; transform: translateY(-1px); }
.rh-unsaved-pill.is-visible { opacity: 1; }
#saveBtn.has-unsaved-order { box-shadow: 0 0 0 2px color-mix(in srgb, var(--warning) 26%, transparent); }
.toast-region { position: fixed; bottom: 1.25rem; right: 1.25rem; display: flex; flex-direction: column; gap: .5rem; z-index: 9999; pointer-events: none; }
.toast { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: .65rem 1rem; font-size: .8125rem; box-shadow: 0 8px 24px rgba(0,0,0,.28); display: flex; align-items: center; gap: .5rem; max-width: 380px; animation: toast-in .2s ease-out; pointer-events: auto; }
.toast.success { border-color: color-mix(in srgb, var(--success) 40%, var(--border)); }
.toast.error { border-color: color-mix(in srgb, var(--danger) 40%, var(--border)); }
.toast.success i { color: var(--success); }
.toast.error i { color: var(--danger); }
@keyframes toast-in { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
.empty-state { display: grid; justify-items: center; gap: .65rem; text-align: center; color: var(--text-muted); border: 1px dashed var(--border); border-radius: var(--radius-card); padding: 2rem 1rem; }
.empty-state i { font-size: 2rem; color: var(--accent-light); }
.reveal { opacity: 0; transform: translateY(8px); transition: opacity .22s ease-out, transform .22s ease-out; }
.reveal.is-visible { opacity: 1; transform: translateY(0); }
@media (max-width: 700px) {
  .rh-row { grid-template-columns: auto auto minmax(0, 1fr); align-items: start; }
  .rh-position-control { grid-column: 2; }
  .rh-row-info { grid-column: 3; }
  .rh-row-actions { grid-column: 1 / -1; justify-content: flex-start; }
  .rh-row-controls { grid-column: 1; grid-row: span 2; }
  .rh-save-actions .btn, .rh-toolbar .btn, .rh-bulk-select-actions .btn { flex: 1 1 auto; min-width: 0; }
  .session-pill { display: none !important; }
}
@media (max-width: 520px) {
  .rh-row { padding: .5rem; gap: .42rem; }
  .rh-row-actions .rh-row-action-btn, .rh-row-actions .rh-row-danger-btn { flex: 1 1 auto; }
  .rh-toolbar-search .input, .rh-filter-row .input { flex-basis: 100%; }
}
